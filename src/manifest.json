{
  "name": "uuGle",
  "version": "0.3.3",
  "description": "uuGle Chrome extension provides fast and user-friendly searching across Unicorn bookkit and dockit books in browser search bar.",
  "omnibox": { "keyword": "uu" },
  "background": {
    "service_worker": "background.bundle.js"
  },
  "permissions": ["tabs"],
  "host_permissions": [
    "https://*.plus4u.net/uu-bookkitg01-main/*",
    "https://*.plus4u.net/uu-dockitg01-main/*",
    "https://*.plus4u.net/uu-bookkit-maing01/*"
  ],
  "icons": {
    "34": "icon-34.png",
    "128": "icon-128.png"
  },
  "action": {
    "default_icon": {
      "34": "icon-34.png"
    },
    "default_title": "Click Me",
    "default_popup": "popup.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+U",
        "linux": "Ctrl+U",
        "windows": "Ctrl+Shift+U",
        "mac": "Command+Shift+U"
      }
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.plus4u.net/uu-bookkitg01-main/*",
        "https://*.plus4u.net/uu-dockitg01-main/*",
        "https://*.plus4u.net/uu-bookkit-maing01/*"
      ],
      "js": ["contentScript.bundle.js"],
      "css": ["content.styles.css"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "inject.bundle.js",
        "content.styles.css",
        "icon-128.png",
        "icon-34.png"
      ],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],
  "manifest_version": 3,
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
